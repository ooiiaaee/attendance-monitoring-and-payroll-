# Copy to .env for local use. On a host (Render/Railway) set these in its
# "Environment" settings instead — never commit the real values.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Where the frontend lives (CORS). Comma-separate several:
CLIENT_ORIGIN=http://localhost:3000

# Timezone the schedules are written in (the server clock decides when a
# scheduled session starts, and hosts default to UTC).
TZ=Asia/Manila

# Auto-create scheduled sessions every minute. Only on an always-on server.
ENABLE_SCHEDULER=false

# Optional — emails (leave blank to just log instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Attendance <no-reply@yourdomain.com>

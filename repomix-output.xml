        {loading ? (
          <p className="dashboard-loading">Loading...</p>
        ) : (
          <>
            <h2 className="section-heading">Users ({users.length})</h2>
            <div className="card admin-table-wrapper" style={{ marginBottom: "36px" }}>
              <table className="admin-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Staff ID</th>
                    <th></th>

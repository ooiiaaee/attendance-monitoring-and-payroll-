import { useState, useEffect, useCallback, useRef } from "react";
import { Trash2, RefreshCw, Download, Printer, AlertTriangle } from "lucide-react";
import Sidebar from "../components/Sidebar";
import StatusBadge, { STATUS_CONFIG } from "../components/StatusBadge";
import api from "../api/axios";
import "../styles/shared.css";
import "./AttendanceSheet.css";

// The manual "mark as" buttons only make sense for these four attendance
// statuses (not the leave-request statuses that also live in STATUS_CONFIG).
const MARKABLE_STATUSES = ["present", "late", "absent", "excused"];

const POLL_INTERVAL_MS = 5000;

export default function AttendanceSheet() {
  const [departments, setClasses] = useState([]);
  const [selectedClassId, setSelectedClassId] = useState("");
  const [classDetail, setClassDetail] = useState(null);

  const [sessions, setSessions] = useState([]);
  const [selectedSessionId, setSelectedSessionId] = useState("");

  const [records, setRecords] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [savingId, setSavingId] = useState(null);

  const pollRef = useRef(null);

  useEffect(() => {
    api
      .get("/departments")
      .then((res) => {
        setClasses(res.data);
        if (res.data.length > 0) setSelectedClassId(res.data[0]._id);
        else setLoading(false);
      })
      .catch(() => {
        setError("Could not load your departments.");
        setLoading(false);
      });
  }, []);

  useEffect(() => {
    if (!selectedClassId) return;
    setLoading(true);
    setSelectedSessionId("");
    setRecords([]);

    Promise.all([
      api.get(`/departments/${selectedClassId}`),
      api.get(`/sessions/department/${selectedClassId}`),
    ])
      .then(([classRes, sessionsRes]) => {
        setClassDetail(classRes.data);
        setSessions(sessionsRes.data);
        if (sessionsRes.data.length > 0) {
          setSelectedSessionId(sessionsRes.data[0]._id);
        } else {
          setLoading(false);
        }
      })
      .catch(() => {
        setError("Could not load department details.");
        setLoading(false);
      });
  }, [selectedClassId]);

  const loadRecords = useCallback(() => {
    if (!selectedSessionId) return;
    api
      .get(`/attendance/session/${selectedSessionId}`)
      .then((res) => setRecords(res.data))
      .catch(() => setError("Could not load attendance records."))
      .finally(() => setLoading(false));
  }, [selectedSessionId]);

  useEffect(() => {
    if (!selectedSessionId) return;
    setLoading(true);
    loadRecords();

    pollRef.current = setInterval(loadRecords, POLL_INTERVAL_MS);
    return () => clearInterval(pollRef.current);
  }, [selectedSessionId, loadRecords]);

  const recordForStudent = (staffId) =>
    records.find((r) => r.staff?._id === staffId);

  const markStatus = async (staffId, status) => {
    setSavingId(staffId);
    try {
      await api.post("/attendance/manual", {
        sessionId: selectedSessionId,
        staffId,
        status,
      });
      loadRecords();
    } catch (err) {
      setError(err.response?.data?.message || "Could not update status.");
    } finally {
      setSavingId(null);
    }
  };

  const checkOutRecord = async (recordId, staffId) => {
    setSavingId(staffId);
    try {
      await api.put(`/attendance/${recordId}/checkout`);
      loadRecords();
    } catch (err) {
      setError(err.response?.data?.message || "Could not set check-out time.");
    } finally {
      setSavingId(null);
    }
  };

  const removeRecord = async (recordId, staffId) => {
    setSavingId(staffId);
    try {
      await api.delete(`/attendance/${recordId}`);
      loadRecords();
    } catch (err) {
      setError(err.response?.data?.message || "Could not remove record.");
    } finally {
      setSavingId(null);
    }
  };

  const formatSessionLabel = (session) => {
    const d = new Date(session.date);
    return d.toLocaleDateString(undefined, {
      weekday: "short",
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    });
  };

  const staff = classDetail?.staff || [];
  const presentLikeCount = staff.filter((s) => {
    const r = recordForStudent(s._id);
    return r && ["present", "late", "excused"].includes(r.status);
  }).length;

  const selectedSession = sessions.find((s) => s._id === selectedSessionId);
  const selectedClassName = classDetail?.name || "";

  const exportCsv = () => {
    const header = ["Staff Name", "Email", "Status", "Check-in", "Check-out", "Hours", "Flagged"];
    const rows = staff.map((staff) => {
      const record = recordForStudent(staff._id);
      const status = record ? STATUS_CONFIG[record.status].label : "Not checked in";
      const timeFmt = (d) =>
        d ? new Date(d).toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" }) : "";
      const checkIn = record ? timeFmt(record.timestamp) : "";
      const checkOut = record ? timeFmt(record.checkOutTime) : "";
      const hours = record?.hoursWorked != null ? record.hoursWorked : "";
      const flagged = record?.flagged ? record.flagReason || "Yes" : "";
      return [staff.name, staff.email, status, checkIn, checkOut, hours, flagged]
        .map((f) => `"${f}"`)
        .join(",");
    });

    const csvContent = [header.join(","), ...rows].join("\n");
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    const dateLabel = selectedSession
      ? new Date(selectedSession.date).toISOString().slice(0, 10)
      : "session";
    link.href = url;
    link.download = `${selectedClassName || "attendance"}-${dateLabel}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  };

  const exportPdf = () => {
    window.print();
  };

  return (
    <div>
      <Sidebar />
      <div className="page-shell">
        <h1 className="page-title">Department roster</h1>
        <p className="page-subtitle">
          Live view of who's checked in — updates automatically as staff scan.
        </p>

        {error && <div className="banner banner-error">{error}</div>}

        {departments.length === 0 ? (
          <p className="dashboard-loading">Create a department first to see its roster here.</p>
        ) : (
          <>
            <div className="card sheet-controls">
              <div className="sheet-control-field">
                <label className="field-label">Department</label>
                <select
                  className="field-input"
                  value={selectedClassId}
                  onChange={(e) => setSelectedClassId(e.target.value)}
                >
                  {departments.map((c) => (
                    <option key={c._id} value={c._id}>
                      {c.name}
                    </option>
                  ))}
                </select>
              </div>
              <div className="sheet-control-field">
                <label className="field-label">Session</label>
                <select
                  className="field-input"
                  value={selectedSessionId}
                  onChange={(e) => setSelectedSessionId(e.target.value)}
                  disabled={sessions.length === 0}
                >
                  {sessions.length === 0 ? (
                    <option>No sessions yet</option>
                  ) : (
                    sessions.map((s) => (
                      <option key={s._id} value={s._id}>
                        {formatSessionLabel(s)}
                      </option>
                    ))
                  )}
                </select>
              </div>
              <button className="btn btn-ghost sheet-refresh" onClick={loadRecords}>
                <RefreshCw size={14} strokeWidth={2} /> Refresh
              </button>
            </div>

            {sessions.length === 0 ? (
              <p className="dashboard-loading">
                No sessions yet for this department — start one from the Sessions page.
              </p>
            ) : (
              <>
                <div className="sheet-toolbar">
                  <div className="sheet-summary">
                    <span className="sheet-summary-count">{presentLikeCount}</span> of{" "}
                    <span className="sheet-summary-count">{staff.length}</span> accounted for
                  </div>
                  <div className="sheet-export-buttons">
                    <button className="btn btn-ghost" onClick={exportCsv}>
                      <Download size={14} strokeWidth={2} /> Export CSV
                    </button>
                    <button className="btn btn-ghost" onClick={exportPdf}>
                      <Printer size={14} strokeWidth={2} /> Print / PDF
                    </button>
                  </div>
                </div>

                <div id="printable-sheet">
                  <div className="print-only print-header">
                    <div className="print-title">{selectedClassName}</div>
                    <div className="print-subtitle">
                      {selectedSession && formatSessionLabel(selectedSession)}
                    </div>
                  </div>

                  <div className="card sheet-table-wrapper">
                    <table className="sheet-table">
                      <thead>
                        <tr>
                          <th className="sticky-col">Staff</th>
                          <th>Status</th>
                          <th>Check-in</th>
                          <th>Check-out</th>
                          <th>Hours</th>
                          <th className="no-print">Mark as</th>
                        </tr>
                      </thead>
                      <tbody>
                        {staff.map((staff) => {
                          const record = recordForStudent(staff._id);
                          const isSaving = savingId === staff._id;

                          return (
                            <tr key={staff._id}>
                              <td className="sticky-col">
                                <div className="staff-name">{staff.name}</div>
                                <div className="staff-email">{staff.email}</div>
                              </td>
                              <td>
                                {record ? (
                                  <span style={{ display: "inline-flex", alignItems: "center", gap: "5px" }}>
                                    <StatusBadge status={record.status} />
                                    {record.flagged && (
                                      <AlertTriangle
                                        size={13}
                                        strokeWidth={2}
                                        className="flag-icon"
                                        title={record.flagReason || "Flagged for review"}
                                      />
                                    )}
                                  </span>
                                ) : (
                                  <span className="status-badge tone-pending">
                                    Not checked in
                                  </span>
                                )}
                              </td>
                              <td className="time-cell">
                                {record
                                  ? new Date(record.timestamp).toLocaleTimeString(undefined, {
                                      hour: "numeric",
                                      minute: "2-digit",
                                    })
                                  : "—"}
                              </td>
                              <td className="time-cell">
                                {record?.checkOutTime ? (
                                  new Date(record.checkOutTime).toLocaleTimeString(undefined, {
                                    hour: "numeric",
                                    minute: "2-digit",
                                  })
                                ) : record ? (
                                  <button
                                    className="checkout-btn no-print"
                                    disabled={isSaving}
                                    onClick={() => checkOutRecord(record._id, staff._id)}
                                  >
                                    Check out
                                  </button>
                                ) : (
                                  "—"
                                )}
                              </td>
                              <td className="time-cell">
                                {record?.hoursWorked != null ? `${record.hoursWorked}h` : "—"}
                              </td>
                              <td className="no-print">
                                <div className="mark-buttons">
                                  {MARKABLE_STATUSES.map((key) => {
                                    const cfg = STATUS_CONFIG[key];
                                    return (
                                      <button
                                        key={key}
                                        className={`mark-btn tone-${cfg.tone}${
                                          record?.status === key ? " active" : ""
                                        }`}
                                        title={cfg.label}
                                        disabled={isSaving}
                                        onClick={() => markStatus(staff._id, key)}
                                      >
                                        <cfg.icon size={13} strokeWidth={2.5} />
                                      </button>
                                    );
                                  })}
                                  {record && (
                                    <button
                                      className="mark-btn tone-remove"
                                      title="Remove record"
                                      disabled={isSaving}
                                      onClick={() => removeRecord(record._id, staff._id)}
                                    >
                                      <Trash2 size={13} strokeWidth={2.5} />
                                    </button>
                                  )}
                                </div>
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </div>
              </>
            )}
          </>
        )}
      </div>
    </div>
  );
}
</file>


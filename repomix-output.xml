<file path="capstone/src/pages/Dashboard.js">
import { useState, useEffect } from "react";
import { Link } from "react-router-dom";
import { QrCode, ScanLine, CalendarClock } from "lucide-react";
import Sidebar from "../components/Sidebar";
import { useAuth } from "../context/AuthContext";
import api from "../api/axios";
import "../styles/shared.css";
import "./Dashboard.css";

const DAY_ABBR = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

const formatTime = (t) => {
  const [h, m] = t.split(":").map(Number);
  const period = h >= 12 ? "PM" : "AM";
  const hour12 = h % 12 === 0 ? 12 : h % 12;
  return `${hour12}:${String(m).padStart(2, "0")} ${period}`;
};

export default function Dashboard() {
  const { user } = useAuth();
  const isManagerOrHR = user?.role === "manager" || user?.role === "hr";

  const [departments, setClasses] = useState([]);
  const [attendance, setAttendance] = useState([]);
  const [leaveRequests, setLeaveRequests] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const loadTeacherData = async () => {
      const [classesRes, leaveRes] = await Promise.all([
        api.get("/departments"),
        api.get("/leave", { params: { status: "pending" } }),
      ]);
      setClasses(classesRes.data);
      setLeaveRequests(leaveRes.data);
    };

    const loadStudentData = async () => {
      const [classesRes, attendanceRes, leaveRes] = await Promise.all([
        api.get("/departments"),
        api.get(`/attendance/staff/${user._id}`),
        api.get("/leave"),
      ]);
      setClasses(classesRes.data);
      setAttendance(attendanceRes.data);
      setLeaveRequests(leaveRes.data);
    };

    const load = isManagerOrHR ? loadTeacherData : loadStudentData;
    load().finally(() => setLoading(false));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const today = new Date();
  const todayAbbr = DAY_ABBR[today.getDay()];
  const todayLabel = today.toLocaleDateString(undefined, {
    weekday: "long",
    month: "long",
    day: "numeric",
  });

  // Every meeting block today, across all of this user's departments, sorted by time
  const todaysAgenda = departments
    .flatMap((c) =>
      (Array.isArray(c.schedule) ? c.schedule : [])
        .filter((block) => block.day === todayAbbr)
        .map((block) => ({ ...block, classId: c._id, className: c.name }))
    )
    .sort((a, b) => a.startTime.localeCompare(b.startTime));

  const totalStudents = departments.reduce((sum, c) => sum + c.staff.length, 0);
  const pendingLeaveCount = leaveRequests.length;

  const presentCount = attendance.filter((a) => a.status === "present").length;
  const lateCount = attendance.filter((a) => a.status === "late").length;
  const absentCount = attendance.filter((a) => a.status === "absent").length;
  const excusedCount = attendance.filter((a) => a.status === "excused").length;
  const attendanceRate =
    attendance.length > 0
      ? Math.round(((presentCount + lateCount + excusedCount) / attendance.length) * 100)
      : null;
  const pendingOwnLeaveCount = leaveRequests.filter((r) => r.status === "pending").length;

  if (loading) {
    return (
      <div>
        <Sidebar />
        <div className="page-shell">
          <p className="dashboard-loading">Loading...</p>
        </div>
      </div>
    );
  }

  return (
    <div>
      <Sidebar />
      <div className="page-shell">
        <h1 className="page-title">
          {isManagerOrHR ? `Good day, ${user?.name?.split(" ")[0]}` : `Hi, ${user?.name?.split(" ")[0]}`}
        </h1>
        <p className="page-subtitle">
          It's {todayLabel}.{" "}
          {isManagerOrHR ? "Here's your agenda for today." : "Here's where things stand today."}
        </p>

        <div className="bento-grid">
          {/* HERO — today's agenda, the main useful thing on the page */}
          <div className="card bento-hero">
            <div className="bento-hero-heading">
              <CalendarClock size={16} strokeWidth={2} />
              Today's schedule
            </div>

            {todaysAgenda.length === 0 ? (
              <p className="bento-empty">Nothing on the schedule today.</p>
            ) : (
              <div className="agenda-list">
                {todaysAgenda.map((block, i) => (
                  <div className="agenda-row" key={i}>
                    <div className="agenda-time">
                      {formatTime(block.startTime)}
                      <span className="agenda-time-end">– {formatTime(block.endTime)}</span>
                    </div>
                    <div className="agenda-name">{block.className}</div>
                    {isManagerOrHR && (
                      <Link to="/sessions" className="agenda-action">
                        <QrCode size={13} strokeWidth={2} /> Start
                      </Link>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>

          {isManagerOrHR ? (
            <div className="card stat-strip vertical bento-stat-strip">
              <div className="stat-strip-item">
                <div className="stat-strip-value">{totalStudents}</div>
                <div className="stat-strip-label">Enrolled staff</div>
              </div>
              <div className="stat-strip-item tone-accent">
                <div className="stat-strip-value">{pendingLeaveCount}</div>
                <div className="stat-strip-label">Pending leave requests</div>
              </div>
            </div>
          ) : (
            <>
              <div className="card bento-tally-card">
                <div className="tally-headline">
                  <span className="tally-value">
                    {attendanceRate !== null ? `${attendanceRate}%` : "—"}
                  </span>
                  <span className="tally-label">attendance this record</span>
                </div>
                <div className="tally-bar">
                  {attendance.length > 0 && (
                    <>
                      <span
                        className="tally-seg present"
                        style={{ flexBasis: `${(presentCount / attendance.length) * 100}%` }}
                      />
                      <span
                        className="tally-seg late"
                        style={{ flexBasis: `${(lateCount / attendance.length) * 100}%` }}
                      />
                      <span
                        className="tally-seg absent"
                        style={{ flexBasis: `${(absentCount / attendance.length) * 100}%` }}
                      />
                      <span
                        className="tally-seg excused"
                        style={{ flexBasis: `${(excusedCount / attendance.length) * 100}%` }}
                      />
                    </>
                  )}
                </div>
                <div className="rate-breakdown">
                  <div className="rate-breakdown-item"><span className="dot present" />Present {presentCount}</div>
                  <div className="rate-breakdown-item"><span className="dot late" />Late {lateCount}</div>
                  <div className="rate-breakdown-item"><span className="dot absent" />Absent {absentCount}</div>
                  <div className="rate-breakdown-item"><span className="dot excused" />Excused {excusedCount}</div>
                </div>
              </div>
              <div className="card bento-stat">
                <div className="bento-stat-value">{pendingOwnLeaveCount}</div>
                <div className="bento-stat-label">Pending leave requests</div>
              </div>
            </>
          )}
        </div>

        <div className="quick-links-row">
          {isManagerOrHR ? (
            <>
              <Link to="/departments" className="quick-link">
                Manage departments
              </Link>
              <Link to="/attendance" className="quick-link">
                Attendance sheet
              </Link>
              <Link to="/leave" className="quick-link">
                Review leave requests
                {pendingLeaveCount > 0 && (
                  <span className="quick-link-count">{pendingLeaveCount}</span>
                )}
              </Link>
              <Link to="/alerts" className="quick-link">
                Alerts
              </Link>
              <Link to="/schedule" className="quick-link">
                Full week view
              </Link>
            </>
          ) : (
            <>
              <Link to="/checkin" className="quick-link primary">
                <ScanLine size={13} strokeWidth={2} /> Scan to check in
              </Link>
              <Link to="/history" className="quick-link">
                Attendance history
              </Link>
              <Link to="/schedule" className="quick-link">
                Full week view
              </Link>
            </>
          )}
        </div>
      </div>
    </div>
  );
}
</file>


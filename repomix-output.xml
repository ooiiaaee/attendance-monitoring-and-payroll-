}

.blueprint-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.blueprint-card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, transparent 10%, rgba(10, 10, 12, 0.85) 75%);
  padding: 3rem 2rem 2rem 2rem;
  color: #ffffff;
  box-sizing: border-box;
}

.blueprint-tags-row {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 0.8rem;
  flex-wrap: wrap;
}

.blueprint-glass-tag {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 0.3rem 0.8rem;
  border-radius: 100px;
  font-size: 0.75rem;
  font-weight: 500;
  color: #ffffff;
  letter-spacing: 0.03em;
}

.blueprint-card-title {
  font-size: 1.4rem;
  font-weight: 600;
  margin: 0 0 0.5rem 0;
  letter-spacing: -0.01em;

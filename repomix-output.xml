}

.blueprint-arrow-btn:hover {
  background-color: var(--pink-primary);
  color: #ffffff;
  border-color: var(--pink-primary);
  transform: translateY(-2px);
  box-shadow: 0 15px 30px rgba(255, 67, 128, 0.25);
}

.blueprint-stack-col {
  position: relative;
  width: 100%;
  height: 520px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.blueprint-stack-wrapper {
  position: relative;
  width: 400px;
  height: 500px;
}

.blueprint-card {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;

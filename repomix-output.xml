<file path="capstone/src/pages/PayrollReport.js">
import { useState, useEffect } from "react";
import { Download } from "lucide-react";
import Sidebar from "../components/Sidebar";
import api from "../api/axios";
import "../styles/shared.css";
import "./PayrollReport.css";

const todayISO = () => new Date().toISOString().slice(0, 10);
const firstOfMonthISO = () => {
  const d = new Date();
  d.setDate(1);
  return d.toISOString().slice(0, 10);
};

export default function PayrollReport() {
  const [departments, setDepartments] = useState([]);
  const [selectedId, setSelectedId] = useState("");
  const [from, setFrom] = useState(firstOfMonthISO());
  const [to, setTo] = useState(todayISO());
  const [report, setReport] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    api
      .get("/departments")
      .then((res) => {
        setDepartments(res.data);
        if (res.data.length > 0) setSelectedId(res.data[0]._id);
        else setLoading(false);
      })
      .catch(() => {
        setError("Could not load your departments.");
        setLoading(false);
      });
  }, []);

  const runReport = () => {
    if (!selectedId) return;
    setLoading(true);
    setError("");
    api
      .get(`/departments/${selectedId}/payroll`, { params: { from, to } })
      .then((res) => setReport(res.data))
      .catch((err) => setError(err.response?.data?.message || "Could not load the report."))
      .finally(() => setLoading(false));
  };

  useEffect(() => {
    if (selectedId) runReport();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectedId]);

  const exportCsv = () => {
    if (!report) return;
    const header = ["Staff Name", "Email", "Staff ID", "Sessions Worked", "Total Hours"];
    const rows = report.payroll.map((row) =>
      [row.staff.name, row.staff.email, row.staff.staffId || "", row.sessionsWorked, row.totalHours]
        .map((f) => `"${f}"`)
        .join(",")
    );
    const csvContent = [header.join(","), ...rows].join("\n");
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = `${report.departmentName}-payroll-${from}-to-${to}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  };

  const totalHoursAll = report?.payroll.reduce((sum, r) => sum + r.totalHours, 0) || 0;

  return (
    <div>
      <Sidebar />
      <div className="page-shell">
        <h1 className="page-title">Payroll report</h1>
        <p className="page-subtitle">Total hours worked per staff member over a date range.</p>

        {error && <div className="banner banner-error">{error}</div>}

        {departments.length === 0 && !loading ? (
          <p className="dashboard-loading">Create a department first to run a payroll report.</p>
        ) : (
          <>
            <div className="card payroll-controls">
              <div className="payroll-control-field">
                <label className="field-label">Department</label>
                <select
                  className="field-input"
                  value={selectedId}
                  onChange={(e) => setSelectedId(e.target.value)}
                >
                  {departments.map((d) => (
                    <option key={d._id} value={d._id}>
                      {d.name}
                    </option>
                  ))}
                </select>
              </div>
              <div className="payroll-control-field">
                <label className="field-label">From</label>
                <input
                  type="date"
                  className="field-input"
                  value={from}
                  onChange={(e) => setFrom(e.target.value)}
                />
              </div>
              <div className="payroll-control-field">
                <label className="field-label">To</label>
                <input
                  type="date"
                  className="field-input"
                  value={to}
                  onChange={(e) => setTo(e.target.value)}
                />
              </div>
              <button className="btn btn-primary" onClick={runReport} disabled={loading}>
                {loading ? "Running..." : "Run report"}
              </button>
            </div>

            {loading ? (
              <p className="dashboard-loading">Loading...</p>
            ) : report ? (
              <>
                <div className="payroll-toolbar">
                  <div className="payroll-summary">
                    <span className="payroll-summary-count">{totalHoursAll.toFixed(1)}h</span> total
                    across {report.payroll.length} staff · {report.totalSessions} sessions in range
                  </div>
                  <button className="btn btn-ghost" onClick={exportCsv}>
                    <Download size={14} strokeWidth={2} /> Export CSV
                  </button>
                </div>

                <div className="card payroll-table-wrapper">
                  <table className="payroll-table">
                    <thead>
                      <tr>
                        <th>Staff</th>
                        <th>Staff ID</th>
                        <th>Sessions worked</th>
                        <th>Total hours</th>
                      </tr>
                    </thead>
                    <tbody>
                      {report.payroll.map((row) => (
                        <tr key={row.staff._id}>
                          <td>
                            <div className="payroll-staff-name">{row.staff.name}</div>
                            <div className="payroll-staff-email">{row.staff.email}</div>
                          </td>
                          <td className="payroll-cell-muted">{row.staff.staffId || "—"}</td>
                          <td className="payroll-cell-muted">{row.sessionsWorked}</td>
                          <td className="payroll-hours-value">{row.totalHours.toFixed(1)}h</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </>
            ) : null}
          </>
        )}
      </div>
    </div>
  );
}

<file path="capstone/src/components/WeeklySchedule.js">
import "./WeeklySchedule.css";

const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const START_HOUR = 7;
const END_HOUR = 21;
const SLOT_COUNT = (END_HOUR - START_HOUR) * 2; // 30-min slots

const COLORS = ["#a8493a", "#4a9268", "#5b83a8", "#c08a2e", "#8a5ba3", "#3d8a7a"];

const timeToSlot = (time) => {
  const [h, m] = time.split(":").map(Number);
  return (h - START_HOUR) * 2 + (m >= 30 ? 1 : 0);
};

const formatTime = (t) => {
  const [h, m] = t.split(":").map(Number);
  const period = h >= 12 ? "PM" : "AM";
  const hour12 = h % 12 === 0 ? 12 : h % 12;
  return `${hour12}:${String(m).padStart(2, "0")} ${period}`;
};

// entries: [{ day, startTime, endTime, label, colorIndex }]
// Pass one WeeklySchedule per manager's single department, or aggregate many
// departments' blocks together (each tagged with its own label/colorIndex) for
// a full staff/manager weekly view.
export default function WeeklySchedule({ entries = [] }) {
  // Only label hours that actually have a row to sit in — the closing
  // boundary (e.g. 9PM when the grid ends at 9PM) has no row of its own.
  const hourLabels = Array.from({ length: END_HOUR - START_HOUR }, (_, i) => START_HOUR + i);

  return (
    <div className="weekly-schedule">
      <div
        className="ws-grid"
        style={{ gridTemplateRows: `32px repeat(${SLOT_COUNT}, 22px)` }}
      >
        {/* corner */}
        <div className="ws-corner" style={{ gridColumn: 1, gridRow: 1 }} />

        {/* day headers */}
        {DAYS.map((day, i) => (
          <div className="ws-day-header" key={day} style={{ gridColumn: i + 2, gridRow: 1 }}>
            {day}
          </div>
        ))}

        {/* hour labels + gridlines */}
        {hourLabels.map((hour, i) => (
          <div
            key={hour}
            className="ws-hour-label"
            style={{ gridColumn: 1, gridRow: i * 2 + 2 }}
          >
            {hour % 12 === 0 ? 12 : hour % 12}
            {hour >= 12 ? "PM" : "AM"}
          </div>
        ))}

        {/* horizontal gridlines, one per slot row (each row draws its own bottom border) */}
        {Array.from({ length: SLOT_COUNT }, (_, i) => (
          <div
            key={`line-${i}`}
            className={`ws-gridline${i % 2 === 0 ? " hour" : ""}`}
            style={{ gridColumn: `2 / span ${DAYS.length}`, gridRow: i + 2 }}
          />
        ))}

        {/* schedule blocks */}
        {entries.map((entry, i) => {
          const dayIndex = DAYS.indexOf(entry.day);
          if (dayIndex === -1) return null;
          const startSlot = timeToSlot(entry.startTime);
          const endSlot = timeToSlot(entry.endTime);
          const color = COLORS[entry.colorIndex % COLORS.length];

          return (
            <div
              key={i}
              className="ws-block"
              title={`${entry.label || ""} ${formatTime(entry.startTime)}–${formatTime(entry.endTime)}`}
              style={{
                gridColumn: dayIndex + 2,
                gridRow: `${startSlot + 2} / ${endSlot + 2}`,
                background: color,
              }}
            >
              <div className="ws-block-label">{entry.label}</div>
              <div className="ws-block-time">
                {formatTime(entry.startTime)}–{formatTime(entry.endTime)}
              </div>
            </div>
          );
        })}
      </div>

      {entries.length === 0 && <p className="ws-empty">No schedule blocks yet.</p>}
    </div>
  );
}

import { useState, useRef, useEffect } from "react";
import { Link, useLocation, useNavigate } from "react-router-dom";
import {
  LayoutDashboard,
  Users,
  QrCode,
  ScanLine,
  ClipboardList,
  History,
  ShieldAlert,
  Settings2,
  CalendarDays,
  CalendarOff,
  LogOut,
  UserRound,
} from "lucide-react";
import { useAuth } from "../context/AuthContext";
import NotificationBell from "./NotificationBell";
import "./Sidebar.css";

export default function Sidebar() {
  const { user, logout } = useAuth();
  const location = useLocation();
  const navigate = useNavigate();
  const [menuOpen, setMenuOpen] = useState(false);
  const menuRef = useRef(null);

  const isManagerOrHR = user?.role === "manager" || user?.role === "hr";
  const isStaff = user?.role === "staff";
  const isHR = user?.role === "hr";

  const initials = (user?.name || "")
    .split(" ")
    .map((w) => w[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();

  const navItems = [
    { to: "/dashboard", label: "Dashboard", icon: LayoutDashboard, show: true },
    { to: "/departments", label: "Departments", icon: Users, show: isManagerOrHR },
    { to: "/sessions", label: "Work Sessions", icon: QrCode, show: isManagerOrHR },
    { to: "/attendance", label: "Attendance", icon: ClipboardList, show: isManagerOrHR },
    { to: "/alerts", label: "Alerts", icon: ShieldAlert, show: isManagerOrHR },
    { to: "/schedule", label: "Schedule", icon: CalendarDays, show: isManagerOrHR || isStaff },
    { to: "/leave", label: "Leave", icon: CalendarOff, show: isManagerOrHR || isStaff },
    { to: "/checkin", label: "Check In", icon: ScanLine, show: isStaff },
    { to: "/history", label: "History", icon: History, show: isStaff },
    { to: "/admin", label: "HR Admin", icon: Settings2, show: isHR },
  ];

  useEffect(() => {
    const handleClickOutside = (e) => {
      if (menuRef.current && !menuRef.current.contains(e.target)) {
        setMenuOpen(false);
      }
    };
    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  return (
    <>
      <aside className="sidebar">
        <div className="sidebar-brand">
          <div className="sidebar-logo">A</div>
          <span className="sidebar-brand-text">Attendance</span>
        </div>

        <nav className="sidebar-nav">
          {navItems
            .filter((item) => item.show)
            .map(({ to, label, icon: Icon }) => {
              const active = location.pathname === to;
              return (
                <Link key={to} to={to} className={`sidebar-link${active ? " active" : ""}`}>
                  <Icon size={17} strokeWidth={2} />
                  <span>{label}</span>
                </Link>
              );
            })}
        </nav>
      </aside>

      <div className="topbar-account" ref={menuRef}>
        <NotificationBell />
        <button
          className={`topbar-avatar role-${user?.role}`}
          onClick={() => setMenuOpen((o) => !o)}
        >
          {initials}
        </button>

        {menuOpen && (
          <div className="topbar-menu">
            <div className="topbar-menu-header">
              <div className="topbar-menu-name">{user?.name}</div>
              <div className="topbar-menu-role">{user?.role}</div>
            </div>
            <button
              className="topbar-menu-item"
              onClick={() => {
                setMenuOpen(false);
                navigate("/profile");
              }}
            >
              <UserRound size={15} strokeWidth={2} />
              Profile
            </button>
            <button className="topbar-menu-item danger" onClick={logout}>
              <LogOut size={15} strokeWidth={2} />
              Log out
            </button>
          </div>
        )}
      </div>
    </>
  );
}

  white-space: nowrap;
}

.agenda-action:hover {
  background: var(--accent);
  color: white;
}

.bento-stat {
  padding: 18px 20px 18px 24px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.bento-stat::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 4px;
  background: var(--accent);
  opacity: 0.6;
}

.bento-stat.tone-accent {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.bento-stat.tone-accent::before {
  opacity: 1;
}

/* Occupies the same two-row span the previous stacked stat cards did */
.bento-stat-strip {
  grid-row: 1 / 3;
}

.bento-stat-value {
  font-family: var(--font-display);
  font-size: 34px;
  font-weight: 600;
  color: var(--text);
  line-height: 1.1;
}

.bento-stat-label {
  font-size: 12.5px;
  color: var(--text-muted);
  margin-top: 4px;
}

/* --- Ledger tally bar — a stacked bar and a plain figure, not a
   circular progress ring --- */
.bento-tally-card {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.tally-headline {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.tally-value {
  font-family: var(--font-display);
  font-size: 32px;
  font-weight: 600;
  color: var(--text);
}

.tally-label {
  font-size: 12px;
  color: var(--text-muted);
}

.tally-bar {
  display: flex;
  height: 10px;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--border);
}

.tally-seg.present { background: var(--success); }
.tally-seg.late { background: var(--warning); }
.tally-seg.absent { background: var(--danger); }
.tally-seg.excused { background: var(--info); }

.rate-breakdown {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.rate-breakdown-item {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  color: var(--text-muted);
  white-space: nowrap;
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  display: inline-block;
}

.dot.present { background: var(--success); }
.dot.late { background: var(--warning); }
.dot.absent { background: var(--danger); }
.dot.excused { background: var(--info); }

.quick-links-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.quick-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: 20px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text-muted);
  font-size: 12.5px;
  font-weight: 600;
  text-decoration: none;
}

.quick-link:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.quick-link.primary {
  background: var(--accent);
  border-color: var(--accent);
  color: white;
}

.quick-link.primary:hover {
  background: var(--accent-hover);
  color: white;
}

@media (max-width: 900px) {
  .bento-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .bento-hero {
    grid-row: auto;
    order: -1;
    border-top: 3px solid var(--accent);
    background: linear-gradient(180deg, var(--accent-soft) 0%, var(--surface) 140px);

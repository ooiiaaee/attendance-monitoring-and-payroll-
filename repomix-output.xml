<file path="capstone/src/pages/Profile.js">
import { LogOut, UserCheck, Save } from "lucide-react";
import { useState } from "react";
import Sidebar from "../components/Sidebar";
import { useAuth } from "../context/AuthContext";
import api from "../api/axios";
import "../styles/shared.css";
import "./Profile.css";

export default function Profile() {
  const { user, logout, refreshUser } = useAuth();

  const [name, setName] = useState(user?.name || "");
  const [email, setEmail] = useState(user?.email || "");
  const [profileError, setProfileError] = useState("");
  const [profileSuccess, setProfileSuccess] = useState("");
  const [savingProfile, setSavingProfile] = useState(false);

  const initials = (user?.name || "")
    .split(" ")
    .map((w) => w[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();

  const handleProfileSave = async (e) => {
    e.preventDefault();
    setProfileError("");
    setProfileSuccess("");

    if (!name.trim() || !email.trim()) {
      setProfileError("Name and email can't be empty.");
      return;
    }

    setSavingProfile(true);
    try {
      await api.put("/auth/me", { name: name.trim(), email: email.trim() });
      await refreshUser();
      setProfileSuccess("Profile updated.");
    } catch (err) {
      setProfileError(err.response?.data?.message || "Could not update profile.");
    } finally {
      setSavingProfile(false);
    }
  };

  return (
    <div>
      <Sidebar />
      <div className="page-shell">
        <h1 className="page-title">Your profile</h1>
        <p className="page-subtitle">Manage your account details.</p>

        <div className="card profile-card" style={{ marginBottom: "24px" }}>
          <div className="profile-header">
            <div className={`profile-avatar role-${user?.role}`}>{initials}</div>
            <div>
              <div className="profile-name">{user?.name}</div>
              <div className="pill capitalize tone-accent" style={{ marginTop: "4px" }}>{user?.role}</div>
            </div>
          </div>

          {user?.role === "staff" && user?.staffId && (
            <div className="profile-detail-row" style={{ marginBottom: "20px" }}>
              <UserCheck size={16} strokeWidth={2} />
              <div>
                <div className="profile-detail-label">Staff ID</div>
                <div className="profile-detail-value">{user.staffId}</div>
              </div>
            </div>
          )}

          <form onSubmit={handleProfileSave} noValidate>
            {profileError && <div className="banner banner-error">{profileError}</div>}
            {profileSuccess && <div className="banner banner-success">{profileSuccess}</div>}

            <div className="auth-field">
              <label className="field-label">Name</label>
              <input
                className="field-input"
                value={name}
                onChange={(e) => setName(e.target.value)}
              />
            </div>
            <div className="auth-field">
              <label className="field-label">Email</label>
              <input
                className="field-input"
                type="email"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
              />
            </div>
            <button className="btn btn-primary" type="submit" disabled={savingProfile}>
              <Save size={14} strokeWidth={2} />
              {savingProfile ? "Saving..." : "Save changes"}
            </button>
          </form>

          <p className="profile-forgot-note">
            Need your password changed? Only an HR admin can do that — ask them to reset it for
            you from the HR Admin panel.
          </p>
        </div>

        <button className="btn btn-ghost profile-logout" onClick={logout}>
          <LogOut size={15} strokeWidth={2} />
          Log out
        </button>
      </div>
    </div>
  );
}
</file>

<file path="capstone/src/pages/Register.js">
import { useState } from "react";
import { useNavigate, Link } from "react-router-dom";
import { useAuth } from "../context/AuthContext";
import {
  validateEmail,
  validatePassword,
  validateConfirmPassword,
  validateName,
  validateStudentId,
} from "../utils/validators";
import logoImg from "../assets/kajalogo.png";
import "../styles/shared.css";
import "./Auth.css";

export default function Register() {
  const [name, setName] = useState("");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [role, setRole] = useState("staff");
  const [staffId, setStudentId] = useState("");
  const [fieldErrors, setFieldErrors] = useState({});
  const [serverError, setServerError] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [pendingMessage, setPendingMessage] = useState("");
  const { register } = useAuth();
  const navigate = useNavigate();

  const validate = () => {
    const errors = {
      name: validateName(name),
      email: validateEmail(email),
      password: validatePassword(password),
      confirmPassword: validateConfirmPassword(password, confirmPassword),
      staffId: role === "staff" ? validateStudentId(staffId) : "",
    };
    setFieldErrors(errors);
    return !Object.values(errors).some(Boolean);
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setServerError("");
    setPendingMessage("");
    if (!validate()) return;

    setSubmitting(true);
    try {
      const result = await register(
        name,
        email,
        password,
        role,
        role === "staff" ? staffId : undefined
      );

      if (result.pendingApproval) {
        setPendingMessage(result.message);
      } else {
        navigate("/dashboard");
      }
    } catch (err) {
      setServerError(err.response?.data?.message || "Registration failed. Please try again.");
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="auth-page">
      <div className="auth-glass-card">
        
        {/* Left Pink Layered Sidebar Panel */}
        <div className="auth-sidebar-panel">
          <div className="sidebar-content">
            <h2>Welcome Back!</h2>
            <p>To keep connected with us please login with your personal info</p>
            <Link to="/login">
              <button type="button" className="btn-toggle-switch">
                SIGN IN
              </button>
            </Link>
          </div>
        </div>

        {/* Right Form Content */}
        <div className="auth-form-content">
          <div className="auth-logo-container">
            <img src={logoImg} alt="KAJA Logo" className="auth-logo-img" />
            <span className="auth-brand-name">KAJA</span>
          </div>

          {pendingMessage ? (
            <>
              <h1>ALMOST THERE</h1>
              <div className="banner banner-success" style={{ marginTop: "16px" }}>
                {pendingMessage}
              </div>
              <div className="auth-switch" style={{ marginTop: "20px" }}>
                <Link to="/login">Back to sign in</Link>
              </div>
            </>
          ) : (
            <>
              <h1>SIGN UP</h1>

              {serverError && <div className="banner banner-error">{serverError}</div>}

              <form onSubmit={handleSubmit} noValidate>
                <div className="auth-field">
                  <label className="field-label" htmlFor="name">Full Name</label>
                  <input
                    id="name"
                    className="field-input"
                    placeholder="Full Name"
                    value={name}
                    onChange={(e) => setName(e.target.value)}
                    onBlur={() => setFieldErrors((f) => ({ ...f, name: validateName(name) }))}
                  />
                  {fieldErrors.name && <span className="field-error">{fieldErrors.name}</span>}
                </div>

                <div className="auth-field">
                  <label className="field-label" htmlFor="email">Email</label>
                  <input
                    id="email"
                    type="email"
                    className="field-input"
                    placeholder="Email"
                    value={email}
                    onChange={(e) => setEmail(e.target.value)}
                    onBlur={() => setFieldErrors((f) => ({ ...f, email: validateEmail(email) }))}
                  />
                  {fieldErrors.email && <span className="field-error">{fieldErrors.email}</span>}
                </div>

                <div className="auth-field">
                  <label className="field-label" htmlFor="password">Password</label>
                  <input
                    id="password"
                    type="password"
                    className="field-input"
                    placeholder="Password"
                    value={password}
                    onChange={(e) => setPassword(e.target.value)}
                    onBlur={() =>
                      setFieldErrors((f) => ({ ...f, password: validatePassword(password) }))
                    }
                  />
                  {fieldErrors.password && (
                    <span className="field-error">{fieldErrors.password}</span>
                  )}
                </div>

                <div className="auth-field">
                  <label className="field-label" htmlFor="confirmPassword">Confirm Password</label>
                  <input
                    id="confirmPassword"
                    type="password"
                    className="field-input"
                    placeholder="Confirm Password"
                    value={confirmPassword}
                    onChange={(e) => setConfirmPassword(e.target.value)}
                    onBlur={() =>
                      setFieldErrors((f) => ({
                        ...f,
                        confirmPassword: validateConfirmPassword(password, confirmPassword),
                      }))
                    }
                  />
                  {fieldErrors.confirmPassword && (
                    <span className="field-error">{fieldErrors.confirmPassword}</span>
                  )}
                </div>

                <div className="auth-field">
                  <label className="field-label" htmlFor="role">Role</label>
                  <select
                    id="role"
                    className="field-input"
                    value={role}
                    onChange={(e) => setRole(e.target.value)}
                  >
                    <option value="staff">Staff</option>
                    <option value="manager">Manager</option>
                  </select>
                  {role === "manager" && (
                    <p className="auth-role-note">
                      Manager accounts require HR admin approval before you can log in.
                    </p>
                  )}
                </div>

                {role === "staff" && (
                  <div className="auth-field">
                    <label className="field-label" htmlFor="staffId">Staff ID</label>
                    <input
                      id="staffId"
                      className="field-input"
                      value={staffId}
                      placeholder="Staff ID (e.g. 2024-00123)"
                      onChange={(e) => setStudentId(e.target.value)}
                      onBlur={() =>
                        setFieldErrors((f) => ({ ...f, staffId: validateStudentId(staffId) }))
                      }
                    />
                    {fieldErrors.staffId && (
                      <span className="field-error">{fieldErrors.staffId}</span>
                    )}
                  </div>
                )}

                <button
                  className="btn btn-primary"
                  type="submit"
                  disabled={submitting}
                >
                  {submitting ? "Creating account..." : "REGISTER"}
                </button>
              </form>
            </>
          )}
        </div>

      </div>
    </div>
  );
}
</file>


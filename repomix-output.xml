<file path="server/utils/geo.js">
// Distance in meters between two lat/lng points (Haversine formula).
function distanceMeters(lat1, lng1, lat2, lng2) {
  const R = 6371000; // Earth's radius in meters
  const toRad = (deg) => (deg * Math.PI) / 180;
  const dLat = toRad(lat2 - lat1);
  const dLng = toRad(lng2 - lng1);
  const a =
    Math.sin(dLat / 2) ** 2 +
    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  return R * c;
}

module.exports = { distanceMeters };
</file>

<file path="server/utils/mailer.js">
const nodemailer = require("nodemailer");

// If SMTP isn't configured yet, every send just logs and resolves — nothing
// in the app breaks because email hasn't been set up. Works with Gmail,
// SendGrid SMTP, Mailtrap, or any standard SMTP provider.
const isConfigured =
  process.env.SMTP_HOST && process.env.SMTP_USER && process.env.SMTP_PASS;

let transporter = null;
if (isConfigured) {
  transporter = nodemailer.createTransport({
    host: process.env.SMTP_HOST,
    port: Number(process.env.SMTP_PORT) || 587,
    secure: Number(process.env.SMTP_PORT) === 465,
    auth: {
      user: process.env.SMTP_USER,
      pass: process.env.SMTP_PASS,
    },
  });
}

const FROM = process.env.SMTP_FROM || "Attendance <no-reply@company.com>";

/**
 * Sends an email. Silently logs instead of sending if SMTP isn't configured
 * — callers never need to check whether email is set up.
 */
async function sendEmail({ to, subject, text, html }) {
  if (!to) return;

  if (!transporter) {
    console.log(`[mailer] SMTP not configured — would have sent "${subject}" to ${to}`);
    return;
  }

  try {
    await transporter.sendMail({ from: FROM, to, subject, text, html: html || text });
  } catch (error) {
    // Email failures should never break the request that triggered them.
    console.error("[mailer] Failed to send email:", error.message);
  }
}

module.exports = { sendEmail };
</file>

<file path="server/utils/scheduler.js">
const cron = require("node-cron");
const crypto = require("crypto");
const Department = require("../models/Department");
const Session = require("../models/Session");

const QR_VALID_MINUTES = 10;
const DAY_ABBR = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

/**
 * Runs once per tick: finds every department whose schedule has a block
 * starting at the current day/time, and creates a session for it if one
 * doesn't already exist. Auto-generated sessions have no manager location
 * (nobody physically started them), so anti-buddy-punching flagging is
 * simply skipped for their check-ins, same as any session without a
 * captured location.
 */
async function generateDueSessions() {
  const now = new Date();
  const todayAbbr = DAY_ABBR[now.getDay()];
  const currentHHMM = `${String(now.getHours()).padStart(2, "0")}:${String(
    now.getMinutes()
  ).padStart(2, "0")}`;

  const departments = await Department.find({});

  for (const dept of departments) {
    const dueBlock = (dept.schedule || []).find(
      (b) => b.day === todayAbbr && b.startTime === currentHHMM
    );
    if (!dueBlock) continue;

    const startOfDay = new Date(now);
    startOfDay.setHours(0, 0, 0, 0);
    const endOfDay = new Date(now);
    endOfDay.setHours(23, 59, 59, 999);

    const existing = await Session.findOne({
      department: dept._id,
      date: { $gte: startOfDay, $lte: endOfDay },
      scheduleStartTime: dueBlock.startTime,
    });
    if (existing) continue;

    await Session.create({
      department: dept._id,
      date: now,
      qrToken: crypto.randomBytes(16).toString("hex"),
      qrExpiresAt: new Date(now.getTime() + QR_VALID_MINUTES * 60 * 1000),
      autoGenerated: true,
      scheduleStartTime: dueBlock.startTime,
    });

    console.log(`[scheduler] Auto-created session for "${dept.name}" at ${dueBlock.startTime}`);
  }
}

/**
 * Runs once on server startup: catches up on any session that should
 * have been created today (its scheduled start time has already passed)
 * but wasn't — e.g. because the server was down during the exact minute
 * the per-minute check below would normally have caught it. The QR code
 * may already be expired by the time this runs, but the session record
 * still matters for attendance history — a manager can regenerate its QR
 * from the Sessions page, or mark attendance manually.
 */
async function catchUpMissedSessions() {
  const now = new Date();
  const todayAbbr = DAY_ABBR[now.getDay()];
  const currentHHMM = `${String(now.getHours()).padStart(2, "0")}:${String(
    now.getMinutes()
  ).padStart(2, "0")}`;

  const startOfDay = new Date(now);
  startOfDay.setHours(0, 0, 0, 0);
  const endOfDay = new Date(now);
  endOfDay.setHours(23, 59, 59, 999);

  const departments = await Department.find({});

  for (const dept of departments) {
    const dueTodayBlocks = (dept.schedule || []).filter(
      (b) => b.day === todayAbbr && b.startTime <= currentHHMM
    );

    for (const block of dueTodayBlocks) {
      const existing = await Session.findOne({
        department: dept._id,
        date: { $gte: startOfDay, $lte: endOfDay },
        scheduleStartTime: block.startTime,
      });
      if (existing) continue;

      const scheduledDate = new Date(now);
      const [h, m] = block.startTime.split(":").map(Number);
      scheduledDate.setHours(h, m, 0, 0);

      await Session.create({
        department: dept._id,
        date: scheduledDate,
        qrToken: crypto.randomBytes(16).toString("hex"),
        qrExpiresAt: new Date(scheduledDate.getTime() + QR_VALID_MINUTES * 60 * 1000),
        autoGenerated: true,
        scheduleStartTime: block.startTime,
      });

      console.log(
        `[scheduler] Caught up a missed session for "${dept.name}" at ${block.startTime} (server was likely down when it was due)`
      );
    }
  }
}

function startScheduler() {
  // Catch up once immediately in case the server was down when today's
  // sessions were due — the per-minute check below handles everything
  // going forward from here.
  catchUpMissedSessions().catch((err) =>
    console.error("[scheduler] catch-up error:", err.message)
  );

  // Runs every minute — schedule blocks are stored to the minute, so this
  // is the finest granularity that actually matters.
  cron.schedule("* * * * *", () => {
    generateDueSessions().catch((err) => console.error("[scheduler] error:", err.message));
  });
  console.log("[scheduler] Recurring session generator started");
}

module.exports = { startScheduler, generateDueSessions, catchUpMissedSessions };
</file>


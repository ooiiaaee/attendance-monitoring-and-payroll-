const express = require("express");
const router = express.Router();
const LeaveRequest = require("../models/LeaveRequest");
const Department = require("../models/Department");
const { protect, authorize } = require("../middleware/authMiddleware");
const { sendEmail } = require("../utils/mailer");

router.post("/", protect, authorize("staff"), async (req, res) => {
  try {
    const { department, reason, dateFrom, dateTo } = req.body;
    if (!department || !reason || !dateFrom || !dateTo) {
      return res
        .status(400)
        .json({ message: "department, reason, dateFrom, and dateTo are required" });
    }

    const leaveRequest = await LeaveRequest.create({
      staff: req.user._id,
      department,
      reason,
      dateFrom,
      dateTo,
      status: "pending",
    });

    // Notify the department's manager that a request is waiting on them.
    const dept = await Department.findById(department).populate("manager", "name email");
    if (dept?.manager?.email) {
      sendEmail({
        to: dept.manager.email,
        subject: `New leave request from ${req.user.name}`,
        text: `Hi ${dept.manager.name},\n\n${req.user.name} has submitted a leave request for ${dept.name}:\n\nReason: ${reason}\nFrom: ${new Date(dateFrom).toDateString()}\nTo: ${new Date(dateTo).toDateString()}\n\nReview it in the app when you get a chance.`,
      });
    }

    res.status(201).json(leaveRequest);
  } catch (error) {
    res.status(500).json({ message: error.message });
  }
});

router.get("/", protect, async (req, res) => {
  try {
    let query = {};
    if (req.user.role === "staff") {
      query.staff = req.user._id;
    }
    if (req.query.status) {
      query.status = req.query.status;
    }

    const requests = await LeaveRequest.find(query)
      .populate("staff", "name email staffId")
      .populate("department", "name")
      .populate("reviewedBy", "name")
      .sort({ createdAt: -1 });

    res.json(requests);
  } catch (error) {
    res.status(500).json({ message: error.message });
  }
});

router.put("/:id/review", protect, authorize("manager", "hr"), async (req, res) => {
  try {
    const { status } = req.body;
    if (!["approved", "rejected"].includes(status)) {
      return res.status(400).json({ message: "status must be 'approved' or 'rejected'" });
    }

    const leaveRequest = await LeaveRequest.findById(req.params.id).populate(
      "staff",
      "name email"
    );
    if (!leaveRequest) return res.status(404).json({ message: "Leave request not found" });

    leaveRequest.status = status;
    leaveRequest.reviewedBy = req.user._id;
    await leaveRequest.save();

    if (leaveRequest.staff?.email) {
      sendEmail({
        to: leaveRequest.staff.email,
        subject: `Your leave request was ${status}`,
        text: `Hi ${leaveRequest.staff.name},\n\nYour leave request (${new Date(leaveRequest.dateFrom).toDateString()} – ${new Date(leaveRequest.dateTo).toDateString()}) has been ${status} by ${req.user.name}.`,
      });
    }

    res.json(leaveRequest);
  } catch (error) {
    res.status(500).json({ message: error.message });
  }
});

module.exports = router;
</file>

<file path="server/routes/sessionRoutes.js">
const express = require("express");
const crypto = require("crypto");
const router = express.Router();
const Session = require("../models/Session");
const Department = require("../models/Department");
const { protect, authorize } = require("../middleware/authMiddleware");

const QR_VALID_MINUTES = 10;

router.post("/", protect, authorize("manager", "hr"), async (req, res) => {
  try {
    const { departmentId, lat, lng } = req.body;
    if (!departmentId) {
      return res.status(400).json({ message: "departmentId is required" });
    }

    const department = await Department.findById(departmentId);
    if (!department) return res.status(404).json({ message: "Department not found" });

    const isOwner = department.manager.toString() === req.user._id.toString();
    if (!isOwner && req.user.role !== "hr") {
      return res.status(403).json({ message: "You don't manage this department" });
    }

    const qrToken = crypto.randomBytes(16).toString("hex");
    const qrExpiresAt = new Date(Date.now() + QR_VALID_MINUTES * 60 * 1000);

    const session = await Session.create({
      department: departmentId,
      date: new Date(),
      qrToken,
      qrExpiresAt,
      location:
        typeof lat === "number" && typeof lng === "number" ? { lat, lng } : { lat: null, lng: null },
    });

    res.status(201).json(session);
  } catch (error) {
    res.status(500).json({ message: error.message });
  }
});

router.post("/:id/regenerate-qr", protect, authorize("manager", "hr"), async (req, res) => {
  try {
    const session = await Session.findById(req.params.id);
    if (!session) return res.status(404).json({ message: "Session not found" });

    session.qrToken = crypto.randomBytes(16).toString("hex");
    session.qrExpiresAt = new Date(Date.now() + QR_VALID_MINUTES * 60 * 1000);
    await session.save();

    res.json(session);
  } catch (error) {
    res.status(500).json({ message: error.message });
  }
});

router.get("/department/:departmentId", protect, async (req, res) => {
  try {
    const sessions = await Session.find({ department: req.params.departmentId }).sort({
      date: -1,
    });
    res.json(sessions);
  } catch (error) {
    res.status(500).json({ message: error.message });
  }
});

router.get("/:id", protect, async (req, res) => {
  try {
    const session = await Session.findById(req.params.id).populate("department", "name");
    if (!session) return res.status(404).json({ message: "Session not found" });
    res.json(session);
  } catch (error) {
    res.status(500).json({ message: error.message });
  }
});

module.exports = router;
</file>


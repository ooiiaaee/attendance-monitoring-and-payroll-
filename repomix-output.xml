  transform: translateX(0) scale(1);
  opacity: 1;
  pointer-events: auto;
}

.blueprint-card-next {
  z-index: 2;
  transform: translateX(35px) scale(0.93);
  opacity: 0.65;
  pointer-events: auto;
  filter: brightness(0.9);
}

.blueprint-card-far-next {
  z-index: 1;
  transform: translateX(70px) scale(0.86);
  opacity: 0.3;
  pointer-events: none;
  filter: brightness(0.7);
}

.blueprint-card-hidden {
  z-index: 0;
  transform: translateX(100px) scale(0.8);

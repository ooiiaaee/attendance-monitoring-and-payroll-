  color: var(--text-dark);
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin: 0 0 1rem 0;
}

.vision-banner-sub {
  font-size: 1.05rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin: 0 0 2.2rem 0;
}

.vision-banner-btn {
  display: inline-block;
  background-color: var(--pink-primary);
  color: #ffffff;
  padding: 1rem 2.2rem;
  border-radius: 100px;
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-decoration: none;
  box-shadow: 0 10px 25px rgba(255, 67, 128, 0.3);
  transition: all 0.2s ease;
}

.vision-banner-btn:hover {
  background-color: var(--pink-hover);
  transform: translateY(-2px);
}

/* ----------------------------------
   Modern Footer (Pink Styled)
---------------------------------- */
.landing-footer-modern {
  width: 100%;
  background-color: var(--pink-subtle);
  padding: 3rem 4rem 4rem 4rem;
  box-sizing: border-box;
  border-top: 1px solid rgba(255, 67, 128, 0.12);
}

.footer-modern-grid {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.2fr 1.5fr 1.5fr;
  gap: 3rem;
}
.footer-brand-logo-group {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.2rem;
}
.footer-logo-img {
  height: 32px;
  width: auto;
  object-fit: contain;
}

.footer-brand-title {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--text-dark);
  letter-spacing: -0.02em;
  margin: 0; /* Remove bottom margin since container handles spacing now */
}

.footer-contact-info {
  font-size: 0.92rem;
  color: var(--text-muted);
  margin: 0 0 0.4rem 0;
}

.footer-col-head {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-dark);
  margin: 0 0 1.2rem 0;
  letter-spacing: -0.01em;
}

.footer-links-subgrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.8rem 1.5rem;
}

.footer-links-subgrid a {
  font-size: 0.9rem;
  color: var(--text-muted);
  text-decoration: none;
  transition: color 0.2s ease;
}

.footer-links-subgrid a:hover {
  color: var(--pink-primary);
}

.footer-modern-bottom {
  max-width: 1200px;
  margin: 4rem auto 0 auto;
  padding-top: 2rem;
  border-top: 1px solid rgba(255, 67, 128, 0.12);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-social-group {
  display: flex;
  gap: 0.75rem;
}

.social-icon-pill {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background-color: #ffffff;
  border: 1px solid rgba(255, 67, 128, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-dark);
  text-decoration: none;
  box-shadow: 0 2px 5px rgba(255, 67, 128, 0.05);
  transition: all 0.2s ease;
}

.social-icon-pill:hover {
  background-color: var(--pink-primary);
  color: #ffffff;
  border-color: var(--pink-primary);
}

.footer-copyright {
  font-size: 0.85rem;
  color: #7a7e88;
}

/* Responsive Media Adjustments */
@media (max-width: 968px) {
  .blueprint-carousel-container {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .blueprint-stack-col {
    justify-content: center;
  }
  .footer-modern-grid {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .vision-banner-content {
    margin-left: 0;
    text-align: center;
  }
  .vision-banner-card {
    padding: 3rem 1.5rem;
  }
  .footer-modern-bottom {
    flex-direction: column;
    gap: 1.5rem;
    text-align: center;
  }
}

@media (max-width: 480px) {
  .blueprint-stack-wrapper {
    width: 100%;
    max-width: 340px;
    height: 440px;
  }
}
